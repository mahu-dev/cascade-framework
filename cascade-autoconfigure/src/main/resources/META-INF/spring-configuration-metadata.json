{
  "groups": [
    {
      "name": "cascade.cache",
      "type": "io.github.cascade.autoconfigure.core.CascadeCacheProperties",
      "description": "Cascade缓存配置属性"
    },
    {
      "name": "cascade.cache.manager",
      "type": "io.github.cascade.autoconfigure.core.CascadeCacheProperties$ManagerProperties",
      "description": "缓存管理器配置"
    },
    {
      "name": "cascade.cache.defaults",
      "type": "io.github.cascade.autoconfigure.core.CascadeCacheProperties$CacheProperties",
      "description": "默认缓存配置"
    },
    {
      "name": "cascade.cache.defaults.l1",
      "type": "io.github.cascade.autoconfigure.core.CascadeCacheProperties$L1Properties",
      "description": "L1缓存配置"
    },
    {
      "name": "cascade.cache.defaults.l2",
      "type": "io.github.cascade.autoconfigure.core.CascadeCacheProperties$L2Properties",
      "description": "L2缓存配置"
    },
    {
      "name": "cascade.cache.distributed",
      "type": "io.github.cascade.cache.core.properties.DistributedTieredCacheProperties",
      "description": "分布式分层缓存配置"
    }
  ],
  "properties": [
    {
      "name": "cascade.cache.enabled",
      "type": "java.lang.Boolean",
      "description": "是否启用Cascade缓存",
      "defaultValue": true
    },
    {
      "name": "cascade.cache.defaults.enabled",
      "type": "java.lang.Boolean",
      "description": "是否启用默认缓存",
      "defaultValue": true
    },
    {
      "name": "cascade.cache.defaults.record-stats",
      "type": "java.lang.Boolean",
      "description": "是否记录统计信息",
      "defaultValue": true
    },
    {
      "name": "cascade.cache.defaults.allow-null-values",
      "type": "java.lang.Boolean",
      "description": "是否允许null值",
      "defaultValue": true
    },
    {
      "name": "cascade.cache.defaults.default-expiration",
      "type": "java.time.Duration",
      "description": "默认过期时间"
    },
    {
      "name": "cascade.cache.defaults.default-refresh",
      "type": "java.time.Duration",
      "description": "默认刷新时间"
    },
    {
      "name": "cascade.cache.defaults.l1.enabled",
      "type": "java.lang.Boolean",
      "description": "是否启用L1缓存",
      "defaultValue": true
    },
    {
      "name": "cascade.cache.defaults.l1.maximum-size",
      "type": "java.lang.Long",
      "description": "L1缓存最大条目数",
      "defaultValue": 10000
    },
    {
      "name": "cascade.cache.defaults.l1.initial-capacity",
      "type": "java.lang.Integer",
      "description": "L1缓存初始容量",
      "defaultValue": 16
    },
    {
      "name": "cascade.cache.defaults.l1.concurrency-level",
      "type": "java.lang.Integer",
      "description": "L1缓存并发级别",
      "defaultValue": 4
    },
    {
      "name": "cascade.cache.defaults.l1.expire-after-write",
      "type": "java.time.Duration",
      "description": "L1缓存写入后过期时间"
    },
    {
      "name": "cascade.cache.defaults.l1.expire-after-access",
      "type": "java.time.Duration",
      "description": "L1缓存访问后过期时间"
    },
    {
      "name": "cascade.cache.defaults.l1.refresh-after-write",
      "type": "java.time.Duration",
      "description": "L1缓存写入后刷新时间"
    },
    {
      "name": "cascade.cache.defaults.l2.enabled",
      "type": "java.lang.Boolean",
      "description": "是否启用L2缓存",
      "defaultValue": true
    },
    {
      "name": "cascade.cache.defaults.l2.key-prefix",
      "type": "java.lang.String",
      "description": "L2缓存键前缀",
      "defaultValue": "cascade:"
    },
    {
      "name": "cascade.cache.defaults.l2.serializer",
      "type": "java.lang.String",
      "description": "L2缓存序列化器",
      "defaultValue": "json"
    },
    {
      "name": "cascade.cache.defaults.l2.default-ttl",
      "type": "java.time.Duration",
      "description": "L2缓存默认TTL",
      "defaultValue": "1h"
    },
    {
      "name": "cascade.cache.defaults.l2.timeout",
      "type": "java.time.Duration",
      "description": "L2缓存操作超时时间",
      "defaultValue": "5s"
    },
    {
      "name": "cascade.cache.defaults.l2.redis.host",
      "type": "java.lang.String",
      "description": "Redis主机地址",
      "defaultValue": "localhost"
    },
    {
      "name": "cascade.cache.defaults.l2.redis.port",
      "type": "java.lang.Integer",
      "description": "Redis端口",
      "defaultValue": 6379
    },
    {
      "name": "cascade.cache.defaults.l2.redis.database",
      "type": "java.lang.Integer",
      "description": "Redis数据库索引",
      "defaultValue": 0
    },
    {
      "name": "cascade.cache.defaults.l2.redis.password",
      "type": "java.lang.String",
      "description": "Redis密码"
    },
    {
      "name": "cascade.cache.defaults.l2.redis.timeout",
      "type": "java.time.Duration",
      "description": "Redis连接超时时间",
      "defaultValue": "5s"
    },
    {
      "name": "cascade.cache.manager.type",
      "type": "java.lang.String",
      "description": "缓存管理器类型",
      "defaultValue": "simplified"
    },
    {
      "name": "cascade.cache.sync.enabled",
      "type": "java.lang.Boolean",
      "description": "是否启用缓存同步",
      "defaultValue": false
    },
    {
      "name": "cascade.cache.warmup.enabled",
      "type": "java.lang.Boolean",
      "description": "是否启用缓存预热",
      "defaultValue": false
    }
  ],
  "hints": [
    {
      "name": "cascade.cache.defaults.l2.serializer",
      "values": [
        {
          "value": "json",
          "description": "JSON序列化器"
        },
        {
          "value": "jdk",
          "description": "JDK序列化器"
        },
        {
          "value": "kryo",
          "description": "Kryo序列化器"
        }
      ]
    },
    {
      "name": "cascade.cache.manager.type",
      "values": [
        {
          "value": "simplified",
          "description": "简化模式缓存管理器(默认)"
        },
        {
          "value": "advanced",
          "description": "高级模式缓存管理器"
        },
        {
          "value": "compatible",
          "description": "兼容模式缓存管理器"
        }
      ]
    }
  ]
}